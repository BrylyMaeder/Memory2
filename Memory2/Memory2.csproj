<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Memory2</RootNamespace>
    <AssemblyName>Memory2</AssemblyName>
    <Version>1.0.3</Version>
    <Deterministic>true</Deterministic>
    <LangVersion>10.0</LangVersion>
    <AssemblyTitle>Memory2</AssemblyTitle>
    <Authors>Bryly Maeder</Authors>
    <Company>Memory2</Company>
    <Product>Memory2</Product>
    <Copyright>Copyright © 2026 Bryly Maeder</Copyright>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <Title>Memory2</Title>
    <Description>Open-source, high-performance application memory for C# and .NET with typed storage, LINQ, live queries, synchronization, and persistence.</Description>
    <PackageProjectUrl>https://memory2.io</PackageProjectUrl>
    <PackageIcon>favicon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/BrylyMaeder/Memory2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>memory, database, linq, query, fast</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\favicon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSING.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\BENCHMARKS.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\CAPABILITIES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\COMPILED_AT.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\COORDINATE_INTENT.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\REACTIVE_QUERIES.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
